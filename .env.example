# ============================================================================
#  Sorteos Adipa - variables de entorno
#  Copiar a .env.local y completar. NUNCA subir .env.local al repositorio.
#
#  Esta aplicacion NO almacena contrasenas de cuentas Zoom ni de Google.
#  Toda la autenticacion es OAuth: el usuario se autentica en el dominio del
#  proveedor y la app solo recibe tokens revocables.
# ============================================================================

# ---- Base de datos (PostgreSQL / Supabase) ----
DATABASE_URL="postgresql://user:pass@localhost:5432/adipa_sorteos?schema=public"

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Vista previa sin autenticacion (solo desarrollo) ----
# Con AUTH_BYPASS=true la aplicacion salta el login por completo y entrega una
# sesion sintetica, para poder recorrer las pantallas sin credenciales de Zoom.
# Requiere ademas que NODE_ENV no sea "production": los dos candados son
# necesarios, de modo que un despliegue con esta variable puesta no quede abierto.
# La interfaz muestra un aviso naranja permanente mientras esta activo.
AUTH_BYPASS=false

# ---- Cuentas del "Modo prueba" (login manual, solo desarrollo) ----
# Requiere AUTH_DEV_MODE=true y NODE_ENV != production. El proveedor "dev" ya NO
# acepta cualquier correo: solo entran las cuentas listadas aqui, con su contrasena
# verificada en servidor (comparacion de tiempo constante). El rol se deriva del
# dominio del correo (un @adipa.cl entra como administrador).
#
# Formato: pares correo:contrasena separados por comas. Esta variable NO lleva
# prefijo NEXT_PUBLIC_, por lo que nunca se envia al navegador. Poner los valores
# reales solo en .env.local (que esta en .gitignore); jamas en este ejemplo.
AUTH_DEV_MODE=false

# Segundo candado, obligatorio para que el login de demostracion funcione en un
# despliegue de produccion (Vercel, por ejemplo). AUTH_DEV_MODE por si solo NO
# basta ahi: hacen falta las dos. Mientras esta activo, la aplicacion muestra una
# franja roja permanente advirtiendo que el acceso es compartido.
#
# Actívalo solo para demostraciones internas y con una contrasena que NO sea la
# de desarrollo local ni haya circulado por chat o por el historial de git.
ALLOW_DEMO_LOGIN_IN_PRODUCTION=false
DEMO_LOGIN_ACCOUNTS="monitor.demo@gmail.com:CAMBIA_ESTA_CLAVE,admin.demo@adipa.cl:CAMBIA_ESTA_CLAVE"

# ---- Login de operadores: "Iniciar sesion con Zoom" ----
# Mismas credenciales que la app OAuth del Marketplace de abajo.
# Redirect URI a registrar: <AUTH_URL>/api/auth/callback/zoom

# ---- Login de administradores: Google ----
# Solo entran correos @adipa.cl / @adipa.co / @adipa.mx
# Redirect URI a registrar: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- App OAuth de Zoom (marketplace.zoom.us -> Develop -> Build App -> General App) ----
# Tipo: account-level (la instala el admin de la organizacion, una sola vez).
# Scopes requeridos:
#   dashboard_meetings:read:admin   -> reuniones activas y participantes conectados
#   meeting:read:admin              -> host_email y alternative_hosts
#   user:read:admin                 -> usuarios internos de la cuenta (marcado STAFF)
# Estos valores NUNCA se exponen al navegador.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:3000/api/zoom/oauth/callback"

# Secret Token de la app, para validar la firma de los webhooks entrantes.
ZOOM_WEBHOOK_SECRET_TOKEN=""

# ---- Cifrado de tokens Zoom en reposo (AES-256-GCM) ----
# 32 bytes en base64: openssl rand -base64 32
# Rotarla invalida los tokens guardados: habria que volver a vincular las cuentas.
ZOOM_TOKEN_ENCRYPTION_KEY=""

# ---- Reglas de negocio ----
# Dominios que reciben rol ADMINISTRADOR automaticamente (seccion 6 del spec).
ADIPA_ADMIN_DOMAINS="adipa.cl,adipa.co,adipa.mx"
