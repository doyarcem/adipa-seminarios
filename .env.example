# ============================================================================
#  Sorteos Adipa - variables de entorno
#  Copiar a .env.local y completar. NUNCA subir .env.local al repositorio.
#
#  Esta aplicacion NO almacena contrasenas de cuentas Zoom ni de Google.
#  Toda la autenticacion es OAuth: el usuario se autentica en el dominio del
#  proveedor y la app solo recibe tokens revocables.
# ============================================================================

# ---- Base de datos (PostgreSQL / Supabase) ----
DATABASE_URL="postgresql://user:pass@localhost:5432/adipa_sorteos?schema=public"

# ---- Auth.js ----
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# ---- Login de operadores: "Iniciar sesion con Zoom" ----
# Mismas credenciales que la app OAuth del Marketplace de abajo.
# Redirect URI a registrar: <AUTH_URL>/api/auth/callback/zoom

# ---- Login de administradores: Google ----
# Solo entran correos @adipa.cl / @adipa.co / @adipa.mx
# Redirect URI a registrar: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---- App OAuth de Zoom (marketplace.zoom.us -> Develop -> Build App -> General App) ----
# Tipo: account-level (la instala el admin de la organizacion, una sola vez).
# Scopes requeridos:
#   dashboard_meetings:read:admin   -> reuniones activas y participantes conectados
#   meeting:read:admin              -> host_email y alternative_hosts
#   user:read:admin                 -> usuarios internos de la cuenta (marcado STAFF)
# Estos valores NUNCA se exponen al navegador.
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
ZOOM_REDIRECT_URI="http://localhost:3000/api/zoom/oauth/callback"

# Secret Token de la app, para validar la firma de los webhooks entrantes.
ZOOM_WEBHOOK_SECRET_TOKEN=""

# ---- Cifrado de tokens Zoom en reposo (AES-256-GCM) ----
# 32 bytes en base64: openssl rand -base64 32
# Rotarla invalida los tokens guardados: habria que volver a vincular las cuentas.
ZOOM_TOKEN_ENCRYPTION_KEY=""

# ---- Reglas de negocio ----
# Dominios que reciben rol ADMINISTRADOR automaticamente (seccion 6 del spec).
ADIPA_ADMIN_DOMAINS="adipa.cl,adipa.co,adipa.mx"
